# Lava AI Gateway
LAVA_SECRET_KEY=aks_live_3Oa3irVpCD6s1HHgzdSjZs3WB25z6vZTmy0Ory_As0YzwQI0YkRAXOh

# override default
# GEMINI_MODEL=gemini-2.0-flash

PORT=8787

# Development: set to 1 for solid pink placeholder only — no MidAPI or picsum (saves API cost). Omit for production.
# STYLE_DEV_PLACEHOLDER=1

# Scene styling (/prefetch-styles) — pick ONE (ignored while STYLE_DEV_PLACEHOLDER is set):
# (1) MidAPI.ai (easiest): key from https://midapi.ai/api-key — uses mj_txt2img + poll (see server.mjs).
MIDAPI_API_KEY=
# MIDAPI_SPEED=relaxed
# MIDAPI_VERSION=7
# MIDAPI_ASPECT_RATIO=9:16
# MIDAPI_POLL_MS=4000
# MIDAPI_MAX_POLLS=120
#
# (2) Your own worker: POST JSON { nodeId, stylePrompt } → { url } (https). Overrides MidAPI when set.
# STYLE_IMAGE_RESOLVER_URL=https://your-worker.dev/style

# If you see "fetch failed" to api.lava.so: try `curl http://127.0.0.1:8787/health?probe=1`
# (upstreamReachable should be true). Broken IPv6: run with
# `NODE_OPTIONS=--dns-result-order=ipv4first npm start`
